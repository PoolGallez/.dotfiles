{ config, pkgs, inputs, ... }:

{
  imports = [
    ./hardware-configuration.nix   # generated by nixos-generate-config
    ./disko.nix                    # optional: declarative disk layout (see comments)
    ../../modules/nixos
  ];

  # ── Machine identity ───────────────────────────────────────────────
  networking.hostName = "rocky";

  my.system.nix.enable = true;

  my.server.enable = true;
  my.server.services = {
    nextcloud.enable = true;
    pihole.enable = true;
    immich.enable = true;
    calibre.enable = true;
    wireguard.enable = true;
    nginx.enable = true;
    duckdns.enable = true;
  };

  # ── Host-level overrides (override module defaults here) ───────────
  #
  # Example: disable a service you don't want on this host:
  #   my.server.services.immich.enable = false;
  #
  # Example: change the Nextcloud data dir:
  #   services.nextcloud.datadir = "/data/nextcloud";
}
